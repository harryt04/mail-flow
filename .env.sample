# --- Auth.js / NextAuth v5 ---
# Generate with: npx auth secret
AUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000

# --- Google OAuth (also used for Gmail API access — single consent flow) ---
# Create at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: http://localhost:3000/api/auth/callback/google
# Enable the "Gmail API" for the project, and add the gmail.modify scope
# under OAuth consent screen > Scopes.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- MongoDB Atlas ---
MONGODB_URI=
MONGODB_DB=mailflow

# --- Token encryption (AES-256-GCM for stored Gmail OAuth tokens and user-supplied OpenAI keys) ---
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENC_KEY=

# --- OpenAI (TTS: gpt-4o-mini-tts, STT: gpt-4o-mini-transcribe, reply-cleanup: gpt-4o-mini) ---
# https://platform.openai.com/api-keys — funds a 100-action free trial per user; after that,
# each user supplies their own key (Settings, or the onboarding page once their trial runs out).
OPENAI_API_KEY=
